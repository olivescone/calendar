# Copy this file to .env and fill in a secret token.
# Generate one with:  openssl rand -hex 24
SYNC_TOKEN=1234

PORT=3000

# Optional: where to store events.json. Defaults to ./data
# Set this to a mounted persistent volume path on your host (Fly.io/Railway/VPS),
# otherwise data is lost on redeploy/restart on most free hosting tiers.
# DATA_DIR=/data
